    "Annotations": [
      {
        "Id": "0fdababae2df477c83839dc853d07e7e",
        "Title": "1. Đầu vào",
        "DescriptionText": "Chọn sàn gỗ hoàn thiện (SHT-Gỗ Công Nghiệp) trong Revit, hoặc không chọn gì và mở view mặt bằng của tầng để làm mọi sàn gỗ trên tầng. Giữ Dry-run = True cho lần chạy đầu, đọc Báo cáo rồi mới đổi False.",
        "IsExpanded": true,
        "WidthAdjustment": 0.0,
