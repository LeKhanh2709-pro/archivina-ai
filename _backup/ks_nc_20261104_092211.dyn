{
  "Uuid": "7aff0bb7-ffbb-4982-ac9e-ddc5c7d0538f",
  "IsCustomNode": false,
  "Description": "Khao sat ngan chay",
  "Name": "ks_nc",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [
    {
      "Id": "ca9b6887f09a4d4f957130ec85646d81",
      "Name": "Ghi chu",
      "Type": "string",
      "Type2": "string",
      "Value": "ks",
      "Description": "Creates a string."
    }
  ],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels",
      "NodeType": "StringInputNode",
      "Description": "Creates a string.",
      "InputValue": "ks",
      "Id": "ca9b6887f09a4d4f957130ec85646d81",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "e80be900b40541de83e260f09db6f5e3",
          "Name": "",
          "Description": "string",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Khảo sát ngăn cháy lan trên bản sao G19_A_L3-32 (TẦNG 3): chạy công cụ (vẽ thật trên bản sao, không đặt sheet),\n# rồi xuất toàn bộ hình học quanh đó ra JSON (mm) để vẽ ảnh đối chiếu các trục bị sót.\nimport os, sys, json, traceback\nimport clr\nclr.AddReference(\"RevitAPI\")\nclr.AddReference(\"RevitServices\")\nfrom Autodesk.Revit.DB import *\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\nTM = r\"D:\\AI\\_tmp\\revit_nganchay_L3\"\nNGUON = r\"D:AI_tmp\nevit_nganchay_L3\nc_thu.py\"\nkq = []\nmmv = lambda v: UnitUtils.ConvertFromInternalUnits(v, UnitTypeId.Millimeters)\n\n\ndef ten(e):\n    try:\n        return e.Name\n    except Exception:\n        return \"?\"\n\n\ndef p2(p):\n    return [round(mmv(p.X)), round(mmv(p.Y))]\n\n\ntry:\n    doc = DocumentManager.Instance.CurrentDBDocument\n    av = doc.ActiveView\n    kq.append(\"View đang mở: %s\" % av.Name)\n    IN = [None] * 19\n    IN[0] = \"\"\n    IN[4] = False\n    IN[5] = TM\n    IN[10] = False\n    IN[18] = True\n    g = {\"IN\": IN}\n    exec(open(NGUON, encoding=\"utf-8\").read(), g)\n    kq.extend(g[\"OUT\"])\n    TransactionManager.Instance.ForceCloseTransaction()\n    lv = av.GenLevel\n    z = lv.Elevation\n    zc = z + UnitUtils.ConvertToInternalUnits(1000, UnitTypeId.Millimeters)\n    D = {\"tuong\": [], \"khac\": [], \"room\": [], \"cua\": [], \"link\": []}\n    opt = Options()\n    opt.DetailLevel = ViewDetailLevel.Fine\n    for cat in (BuiltInCategory.OST_Walls, BuiltInCategory.OST_Columns, BuiltInCategory.OST_StructuralColumns):\n        for e in FilteredElementCollector(doc, av.Id).OfCategory(cat).WhereElementIsNotElementType():\n            bb = e.get_BoundingBox(None)\n            if bb is None or not (bb.Min.Z - 0.05 <= zc <= bb.Max.Z + 0.05):\n                continue\n            try:\n                vong = [[p2(XYZ(x, y, 0)) for x, y in v] for f in g[\"mat_day\"](e, opt) for v in f]\n            except Exception:\n                vong = []\n            loi = None\n            try:\n                t = g[\"loi_tuong\"](e) if cat == BuiltInCategory.OST_Walls else None\n                if t:\n                    loi = [p2(XYZ(t[0][0], t[0][1], 0)), p2(XYZ(t[1][0], t[1][1], 0)), round(mmv(t[2])), round(mmv(t[3]))]\n            except Exception:\n                pass\n            D[\"tuong\"].append({\"id\": e.Id.Value, \"cat\": str(cat), \"kieu\": ten(doc.GetElement(e.GetTypeId())),\n                               \"vong\": vong, \"loi\": loi})\n    for cat in (BuiltInCategory.OST_Doors, BuiltInCategory.OST_Windows):\n        for e in FilteredElementCollector(doc).OfCategory(cat).WhereElementIsNotElementType():\n            if e.LevelId == lv.Id:\n                try:\n                    D[\"cua\"].append({\"cat\": str(cat), \"p\": p2(e.Location.Point), \"kieu\": ten(e.Symbol) + \" | \" + e.Symbol.FamilyName,\n                                     \"pts\": [p2(XYZ(x, y, 0)) for x, y in g[\"diem_hai_ben\"](e)]})\n                except Exception:\n                    pass\n    for e in FilteredElementCollector(doc, av.Id).WhereElementIsNotElementType():\n        c = e.Category\n        if c is None:\n            continue\n        if c.Id.Value in (int(BuiltInCategory.OST_Walls), int(BuiltInCategory.OST_Doors), int(BuiltInCategory.OST_Windows)):\n            continue\n        bb = e.get_BoundingBox(av)\n        if bb is None:\n            continue\n        try:\n            fam = e.Symbol.FamilyName\n        except Exception:\n            fam = \"\"\n        D[\"khac\"].append({\"id\": e.Id.Value, \"cat\": c.Name, \"fam\": fam, \"kieu\": ten(doc.GetElement(e.GetTypeId())),\n                          \"ten\": ten(e), \"min\": p2(bb.Min), \"max\": p2(bb.Max)})\n    o = SpatialElementBoundaryOptions()\n    o.SpatialElementBoundaryLocation = SpatialElementBoundaryLocation.CoreBoundary\n    for r in FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Rooms).WhereElementIsNotElementType():\n        if r.LevelId != lv.Id or r.Location is None:\n            continue\n        D[\"room\"].append({\"ten\": r.get_Parameter(BuiltInParameter.ROOM_NAME).AsString(), \"p\": p2(r.Location.Point),\n                          \"m2\": round(UnitUtils.ConvertFromInternalUnits(r.Area, UnitTypeId.SquareMeters), 2),\n                          \"vong\": [[p2(s.GetCurve().GetEndPoint(0)) for s in segs] for segs in (r.GetBoundarySegments(o) or [])]})\n    for li in FilteredElementCollector(doc).OfClass(RevitLinkInstance):\n        ld = li.GetLinkDocument()\n        info = {\"ten\": ten(li), \"co_doc\": ld is not None, \"tuong\": []}\n        if ld is not None:\n            tf = li.GetTotalTransform()\n            for cat in (BuiltInCategory.OST_Walls, BuiltInCategory.OST_StructuralColumns, BuiltInCategory.OST_Columns):\n                for e in FilteredElementCollector(ld).OfCategory(cat).WhereElementIsNotElementType():\n                    bb = e.get_BoundingBox(None)\n                    if bb is None:\n                        continue\n                    a, b = tf.OfPoint(bb.Min), tf.OfPoint(bb.Max)\n                    if not (min(a.Z, b.Z) - 0.05 <= zc <= max(a.Z, b.Z) + 0.05):\n                        continue\n                    try:\n                        vong = []\n                        for f in g[\"mat_day\"](e, opt):\n                            for v in f:\n                                vong.append([p2(tf.OfPoint(XYZ(x, y, 0))) for x, y in v])\n                    except Exception:\n                        vong = []\n                    info[\"tuong\"].append({\"id\": e.Id.Value, \"cat\": str(cat), \"kieu\": ten(ld.GetElement(e.GetTypeId())), \"vong\": vong})\n        D[\"link\"].append(info)\n    with open(os.path.join(TM, \"hinh_hoc.json\"), \"w\", encoding=\"utf-8\") as f:\n        json.dump(D, f, ensure_ascii=False)\n    kq.append(\"Tường %d, cửa %d, khác %d, room %d, link %s\" % (len(D[\"tuong\"]), len(D[\"cua\"]), len(D[\"khac\"]), len(D[\"room\"]),\n                                                              [(l[\"ten\"], len(l[\"tuong\"])) for l in D[\"link\"]]))\nexcept Exception:\n    kq.append(traceback.format_exc())\nwith open(os.path.join(TM, \"ket_qua_ks.txt\"), \"w\", encoding=\"utf-8\") as f:\n    f.write(\"\\n\".join(kq))\nOUT = kq\n",
      "Engine": "PythonNet3",
