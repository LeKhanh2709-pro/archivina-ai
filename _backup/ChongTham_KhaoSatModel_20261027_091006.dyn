{
  "Uuid": "0633fea1-5532-4858-b9c8-2538b212e355",
  "IsCustomNode": false,
  "Description": "CHỈ ĐỌC: khảo sát model (Room, sàn, cửa, thiết bị, trục / hộp kỹ thuật, kiểu hatch / nét / template) + xuất ảnh view đang mở, để viết công cụ chống thấm / ngăn cháy / lỗ mở bản Revit. Không sửa model.",
  "Name": "ChongTham_KhaoSatModel",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [
    {
      "Id": "9fb7524f29aa4c12a6f0ec34a199218d",
      "Name": "Thư mục ghi kết quả",
      "Type": "string",
