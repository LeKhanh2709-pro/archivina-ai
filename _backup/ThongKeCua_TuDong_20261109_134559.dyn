          "Name": "IN[3]",
          "Description": "Dry-run (True = chỉ báo cáo)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "ca0ad565352f49be8098742c0fb9ff09",
          "Name": "IN[4]",
          "Description": "Mẫu tên bảng ({loai}, {tang}, {view})",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "29d7c25b8952457f86833c1fec1dea61",
          "Name": "IN[5]",
          "Description": "Mở bảng vừa tạo",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "5d82f193701c4a7093019137da096609",
          "Name": "IN[6]",
          "Description": "Chỉ đếm cửa thấy trên sheet đặt bảng (Filter by sheet)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "54531366543349f794fc70465782c9ad",
          "Name": "IN[7]",
          "Description": "Đổi tên cửa: JSON {id type: Type Mark mới} (trống = không đổi)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "458913ce3fc74e7c92a4ffd65731575d",
          "Name": "IN[8]",
          "Description": "Tạo / cập nhật bảng thống kê Revit",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "baf0dce8060e4787b82dad2ad57e2337",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
