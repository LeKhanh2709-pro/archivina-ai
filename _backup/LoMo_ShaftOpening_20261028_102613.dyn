    },
    {
      "ConcreteType": "CoreNodeModels.Watch, CoreNodeModels",
      "WatchWidth": 900.0,
      "WatchHeight": 500.0,
      "Id": "2a1cf3c733fa4b1cbfc3afaadccb1eea",
      "NodeType": "ExtensionNode",
      "Inputs": [
        {
