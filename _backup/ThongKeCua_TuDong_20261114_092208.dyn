{
  "Uuid": "5dd61709-2b3c-4d8a-bb0f-43791ca5e35b",
  "IsCustomNode": false,
  "Description": "Bảng thống kê cửa đi / cửa sổ của mặt bằng đang mở: cột Ký hiệu (Type Mark) / Rộng / Cao / Số lượng, gộp theo Type Mark (cửa trùng hiện 1 dòng), lọc theo tầng của mặt bằng, bỏ cửa có Type Comments chứa chữ Louver, Lam thép hoặc Lam nhôm; bấm lại thì cập nhật bảng cũ, không tạo trùng. Thêm: đặt Mark + tag vách kính (curtain wall) bằng Mark. Mặc định Dry-run.",
  "Name": "ThongKeCua_TuDong",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [
    {
      "Id": "e2af8d71af6b43e08d53e6cf12e9d78b",
      "Name": "Tên view mặt bằng (trống = view đang mở)",
