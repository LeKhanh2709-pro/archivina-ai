      "Type2": "string",
      "Value": "Louver;Lam thép;Lam nhôm",
      "Description": "Creates a string."
    },
    {
      "Id": "63f0fb6e21b14fae9ec624d0acbd3884",
      "Name": "Dry-run (True = chỉ báo cáo)",
