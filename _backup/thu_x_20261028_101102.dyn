  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels",
      "NodeType": "StringInputNode",
      "Description": "Creates a string.",
      "InputValue": "D:\\AI\\_tmp\\revit_lomo_x",
      "Id": "8cf324c570364947a3254a50283df166",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "6c90558833dc4948885402434822d641",
          "Name": "",
          "Description": "string",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n# THỬ API trên BẢN SAO G19: thêm Symbolic Line dấu X vào sketch của 1 shaft opening (SketchEditScope).\nimport os, traceback\nimport clr\nclr.AddReference(\"RevitAPI\")\nclr.AddReference(\"RevitServices\")\nfrom Autodesk.Revit.DB import *\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\ndoc = DocumentManager.Instance.CurrentDBDocument\nOUTD = IN[0]\nbc = []\n\n\ndef ten(e):\n    try:\n        return e.Name\n    except Exception:\n        return \"?\"\n\n\nclass BoQua(IFailuresPreprocessor):\n    __namespace__ = \"ARV.ThuX\"\n\n    def PreprocessFailures(self, fa):\n        for m in fa.GetFailureMessages():\n            bc.append(\"  failure: %s | %s\" % (m.GetSeverity(), m.GetDescriptionText()))\n            if m.GetSeverity() == FailureSeverity.Warning:\n                fa.DeleteWarning(m)\n        return FailureProcessingResult.Continue\n\n\ntry:\n    TransactionManager.Instance.ForceCloseTransaction()\n    bc.append(\"BuiltInCategory có Shaft/Symbolic: %s\" % [n for n in dir(BuiltInCategory) if \"Shaft\" in n or \"Symbolic\" in n or \"SketchLines\" in n])\n    sh = list(FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_ShaftOpening).WhereElementIsNotElementType())\n    bc.append(\"Shaft: %d\" % len(sh))\n    op = sh[0]\n    bc.append(\"Opening: %s | thuộc tính có SketchId: %s\" % (op.GetType().Name, hasattr(op, \"SketchId\")))\n    sk = [doc.GetElement(i) for i in op.GetDependentElements(ElementClassFilter(Sketch))]\n    bc.append(\"Sketch phụ thuộc: %d\" % len(sk))\n    sketch = sk[0]\n    for i in sketch.GetAllElements():\n        e = doc.GetElement(i)\n        bc.append(\"  phần tử sketch: %s | cat %s | style %s\" % (e.GetType().Name, e.Category.Name if e.Category else \"-\",\n                  e.LineStyle.Name if hasattr(e, \"LineStyle\") and e.LineStyle else \"-\"))\n    cat = op.Category\n    bc.append(\"Subcategory của %s: %s\" % (cat.Name, [c.Name for c in cat.SubCategories]))\n    bc.append(\"doc.Create có NewSymbolicCurve: %s; FamilyCreate: %s\" % (hasattr(doc.Create, \"NewSymbolicCurve\"), doc.FamilyCreate))\n    pts = []\n    for c in op.BoundaryCurves:\n        pts.append(c.GetEndPoint(0))\n    xs = [p.X for p in pts]; ys = [p.Y for p in pts]; z = sketch.SketchPlane.GetPlane().Origin.Z\n    a, b = XYZ(min(xs), min(ys), z), XYZ(max(xs), max(ys), z)\n    c_, d = XYZ(min(xs), max(ys), z), XYZ(max(xs), min(ys), z)\n    # thử: SketchEditScope + NewModelCurve, xem phần tử tạo ra và line style chọn được\n    ses = SketchEditScope(doc, \"Thu X\")\n    ses.Start(sketch.Id)\n    t = Transaction(doc, \"Thu X\")\n    t.Start()\n    mc = doc.Create.NewModelCurve(Line.CreateBound(a, b), sketch.SketchPlane)\n    bc.append(\"Tạo: %s | cat %s | style %s\" % (mc.GetType().Name, mc.Category.Name if mc.Category else \"-\", mc.LineStyle.Name))\n    ids = mc.GetLineStyleIds()\n    bc.append(\"Line style chọn được: %s\" % [ten(doc.GetElement(i)) for i in ids])\n    hop = [i for i in ids if \"symbol\" in ten(doc.GetElement(i)).lower() or \"shaft\" in ten(doc.GetElement(i)).lower()]\n    if hop:\n        mc.LineStyle = doc.GetElement(hop[0])\n        bc.append(\"Đổi style → %s | type %s\" % (mc.LineStyle.Name, mc.GetType().Name))\n    mc2 = doc.Create.NewModelCurve(Line.CreateBound(c_, d), sketch.SketchPlane)\n    if hop:\n        mc2.LineStyle = doc.GetElement(hop[0])\n    t.Commit()\n    ses.Commit(BoQua())\n    bc.append(\"Commit sketch OK\")\n    op2 = doc.GetElement(op.Id)\n    bc.append(\"Sau commit: opening còn: %s; số cạnh biên: %d\" % (op2 is not None, op2.BoundaryCurves.Size if op2 else -1))\n    for i in sketch.GetAllElements():\n        e = doc.GetElement(i)\n        bc.append(\"  phần tử sketch sau: %s | cat %s | style %s\" % (e.GetType().Name, e.Category.Name if e.Category else \"-\",\n                  e.LineStyle.Name if hasattr(e, \"LineStyle\") and e.LineStyle else \"-\"))\n    doc.Save()\n    bc.append(\"ĐÃ LƯU bản sao\")\nexcept Exception:\n    bc.append(traceback.format_exc())\nopen(os.path.join(OUTD, \"thu_x.txt\"), \"w\", encoding=\"utf-8\").write(\"\\n\".join(bc))\nOUT = bc\n",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "059951c44448486ba0e3c9b37238ea1b",
      "NodeType": "PythonScriptNode",
      "Inputs": [
