{
  "Uuid": "4e06c33c-ae98-4da9-a11c-ee924807ef53",
  "IsCustomNode": false,
  "Description": "Chọn 1 cửa đi / cửa sổ có sẵn family → tạo mặt bằng (callout), mặt đứng (nhìn từ ngoài nhà), mặt cắt tỉ lệ 1/25 kèm kích thước tổng, đặt vào ô trống tiếp theo của sheet 'CHI TIẾT CỬA' (khung A1 chia 6 ô, hết ô thì tạo sheet mới). View template 'CHI TIẾT CỬA - ...' chưa có thì tạo từ template 1/25 có sẵn. Mỗi type chỉ làm 1 lần. Không xoá, không sửa cửa / tường / template đã có. Mặc định Dry-run.",
  "Name": "ChiTietCua_TuDong",
  "ElementResolver": {
    "ResolutionMap": {}
  },
