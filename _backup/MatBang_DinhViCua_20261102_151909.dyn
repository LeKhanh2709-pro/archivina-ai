      "Description": "Creates a string.",
      "InputValue": "OST_Doors;OST_Windows",
      "Id": "53186c4cb94149cdb6009aa960ea661a",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "b03ba44b58b34bc8b3adfe0879f07bb4",
          "Name": "",
          "Description": "string",
          "UsingDefaultValue": false,
