{
  "Uuid": "7f2d6600-e6ad-4db0-adc2-930af5715398",
  "IsCustomNode": false,
  "Description": "Tự động tag cửa đi (AV_Door Tag) + cửa sổ (AV_Window Tag) trên mặt bằng đang mở: bỏ đối tượng có Type Comments Louver; tag hiện đúng Type Mark (bỏ tiền tố S3. trong nhãn family); tag ngang, ưu tiên nằm ngay giữa cửa (cửa đi phía không mở cánh, cửa sổ phía ngoài), không đè cửa / cánh mở / tường / chữ; tag lệch khỏi giữa cửa thì có leader; tạo + gán view template '<gốc> (ẩn nội thất)'; cửa có EI mà tag không hiện EI thì báo; bấm lại không tạo trùng. Mặc định Dry-run.",
  "Name": "TagCua_TuDong",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [
    {
      "Id": "f0433d743093442e9eefc543130ac760",
      "Name": "Tên view mặt bằng (trống = view đang mở)",
      "Type": "string",
