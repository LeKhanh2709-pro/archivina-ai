      "InputValue": "OST_Doors;OST_Windows",
      "Id": "4bbc5f7e13d4417fb37e6d3aaa679091",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "4f1db9d053b543a6b15d1d4fbf8a5c88",
          "Name": "",
          "Description": "string",
