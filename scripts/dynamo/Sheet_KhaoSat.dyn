{
  "Uuid": "c6933b10-16ec-4dd5-819e-74be50003d58",
  "IsCustomNode": false,
  "Description": "CHỈ ĐỌC: khảo sát cách nhóm sheet (giai đoạn / hạng mục), khung tên, sheet có sẵn, kiểu viewport, bảng thống kê; xuất ảnh vài sheet. Không sửa model.",
  "Name": "Sheet_KhaoSat",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [
    {
      "Id": "aee6215d5fc94388b7541905196017cd",
      "Name": "Thư mục ghi kết quả",
      "Type": "string",
      "Type2": "string",
