{
  "Uuid": "5bec0d48-1551-4c05-80c1-a3870d9b530d",
  "IsCustomNode": false,
  "Description": "CHỈ ĐỌC: khảo sát bổ sung cho công cụ tag cửa (cửa sổ, EI, nội bộ family tag, kích thước tag, view template). Không sửa model.",
  "Name": "TagCua_KhaoSat2",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [
    {
      "Id": "97a114552a994f7ba9cbb35055d3cf16",
      "Name": "Thư mục ghi kết quả",
      "Type": "string",
