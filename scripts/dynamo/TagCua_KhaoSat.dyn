{
  "Uuid": "a1599f2b-a20f-4f59-8a12-6df7f1697af6",
  "IsCustomNode": false,
  "Description": "CHỈ ĐỌC: khảo sát family tag cửa, cửa (Mark / Type Mark / kích thước), tag cửa đang có (view, kiểu, leader, vị trí so với cửa), view mặt bằng + xuất ảnh, để viết công cụ tự động tag cửa. Không sửa model.",
  "Name": "TagCua_KhaoSat",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [
    {
      "Id": "9d8b4f9942ca4bfab2216ac7659d4e37",
      "Name": "Thư mục ghi kết quả",
      "Type": "string",
