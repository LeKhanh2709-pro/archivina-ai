<!-- Hộp thoại Vách kính Revit (theo bố cục bảng VK người dùng duyệt 2026-10-31): sơ đồ mặt bằng trên cùng,
     nhập liệu bên trái, bảng các ô + xem trước mặt đứng (như MDVK) bên phải. Màu đặt trong code (sáng / tối). -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Vách kính - Archivina" Width="940" Height="800" MinWidth="760" MinHeight="600"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource Chu}" Background="{DynamicResource Nen}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{DynamicResource Ln}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border Background="{DynamicResource Tieude}" BorderBrush="{DynamicResource Ln}" BorderThickness="0,0,0,1">
        <DockPanel Margin="14,0,8,0" LastChildFill="False">
          <Path DockPanel.Dock="Left" Style="{DynamicResource BieuTuong}" Data="M4 4h16v16H4z M12 4v16" Margin="0,0,8,0"/>
          <TextBlock DockPanel.Dock="Left" Text="Vách kính" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock DockPanel.Dock="Left" Text="Curtain wall chia đố theo quy tắc VK" Foreground="{DynamicResource Chu2}" FontSize="12" VerticalAlignment="Center"/>
          <Button x:Name="btnDong" DockPanel.Dock="Right" Style="{DynamicResource NutPhang}" ToolTip="Đóng" AutomationProperties.Name="Đóng">
            <Path Style="{DynamicResource BieuTuong}" Data="M6 6l12 12 M18 6L6 18" Width="12" Height="12"/>
          </Button>
          <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource Ln}" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,6,0">
            <StackPanel Orientation="Horizontal">
              <ToggleButton x:Name="tgSang" Style="{DynamicResource NutCheDo}" ToolTip="Giao diện sáng" AutomationProperties.Name="Giao diện sáng">
                <Path x:Name="icSang" Style="{DynamicResource BieuTuong}" Data="M12 8a4 4 0 1 0 0 8a4 4 0 0 0 0-8z M12 2v3 M12 19v3 M2 12h3 M19 12h3 M4.9 4.9l2.1 2.1 M17 17l2.1 2.1 M4.9 19.1l2.1-2.1 M17 7l2.1-2.1"/>
              </ToggleButton>
              <ToggleButton x:Name="tgToi" Style="{DynamicResource NutCheDo}" ToolTip="Giao diện tối" AutomationProperties.Name="Giao diện tối">
                <Path x:Name="icToi" Style="{DynamicResource BieuTuong}" Data="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/>
              </ToggleButton>
            </StackPanel>
          </Border>
        </DockPanel>
      </Border>

      <Grid Grid.Row="1" Margin="12,12,12,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="140"/>
          <RowDefinition Height="10"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{DynamicResource Khung}" Padding="10,8">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="{DynamicResource So}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="Cửa sổ" FontSize="11" Foreground="{DynamicResource Chu2}" Margin="0,0,10,0"/>
                <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="{DynamicResource Di}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="Cửa đi" FontSize="11" Foreground="{DynamicResource Chu2}"/>
              </StackPanel>
              <TextBlock x:Name="lblSoDo" Text="Mặt bằng vách, trái sang phải. Bấm vào ô để tích / bỏ tích cửa" FontSize="11" Foreground="{DynamicResource Chu2}"/>
            </DockPanel>
            <Canvas x:Name="cvPlan" ClipToBounds="True" Background="Transparent"/>
          </DockPanel>
        </Border>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="54*"/>
          </Grid.ColumnDefinitions>

          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <Border Style="{DynamicResource Khung}" Margin="0,0,0,10">
                <StackPanel>
                  <CheckBox x:Name="chkGoc" Content="Vách góc vuông (2 cánh)" AutomationProperties.Name="Vách góc vuông" Margin="0,0,0,6"/>
                  <Border x:Name="bdCanh" BorderBrush="{DynamicResource Ln}" BorderThickness="1" CornerRadius="4" ClipToBounds="True" Margin="0,0,0,8">
                    <UniformGrid Rows="1">
                      <ToggleButton x:Name="tgCanh1" Style="{DynamicResource NutDoan}" AutomationProperties.Name="Cánh 1">
                        <TextBlock Text="Cánh 1 (đố góc)" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                      </ToggleButton>
                      <ToggleButton x:Name="tgCanh2" Style="{DynamicResource NutDoan}" AutomationProperties.Name="Cánh 2">
                        <TextBlock Text="Cánh 2 (kính góc)" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                      </ToggleButton>
                    </UniformGrid>
                  </Border>
                  <TextBlock Style="{DynamicResource Nhan}" Text="Tên vách (Mark)"/>
                  <Grid Margin="0,0,0,8">
                    <TextBox x:Name="txtTen" AutomationProperties.Name="Tên vách"/>
                    <TextBlock x:Name="lblTenTuDat" IsHitTestVisible="False" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource Chu3}"/>
                  </Grid>
                  <TextBlock x:Name="lblDai" Style="{DynamicResource Nhan}" Text="Chiều dài vách (mm, mép ngoài - mép ngoài)"/>
                  <DockPanel Margin="0,0,0,8">
                    <Button x:Name="btnPick" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,0" AutomationProperties.Name="Pick điểm" ToolTip="Chọn điểm trên mặt bằng">
                      <StackPanel Orientation="Horizontal">
                        <Path Style="{DynamicResource BieuTuong}" Data="M12 5a7 7 0 1 0 0 14a7 7 0 0 0 0-14z M12 2v6 M12 16v6 M2 12h6 M16 12h6" Margin="0,0,6,0" Width="14" Height="14"/>
                        <TextBlock x:Name="lblPick" Text="Pick 2 điểm"/>
                      </StackPanel>
                    </Button>
                    <TextBox x:Name="txtDai" AutomationProperties.Name="Chiều dài vách"/>
                  </DockPanel>
                  <TextBlock Style="{DynamicResource Nhan}" Text="Chiều cao vách (mm, từ sàn)"/>
                  <TextBox x:Name="txtCao" AutomationProperties.Name="Chiều cao vách"/>
                </StackPanel>
              </Border>

              <Border Style="{DynamicResource Khung}" Margin="0,0,0,10">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Grid.ColumnSpan="5" Text="Cửa sổ mở (CuaSoVK_A_loai2)" FontSize="12" Foreground="{DynamicResource So}" Margin="0,0,0,6"/>
                  <StackPanel Grid.Row="1"><TextBlock Style="{DynamicResource Nhan}" Text="Số lượng"/><TextBox x:Name="txtNs" AutomationProperties.Name="Số lượng cửa sổ"/></StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Style="{DynamicResource Nhan}" Text="Rộng tâm - tâm"/><TextBox x:Name="txtWs" AutomationProperties.Name="Rộng cửa sổ"/></StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="4"><TextBlock Style="{DynamicResource Nhan}" Text="Cao cửa sổ"/><TextBox x:Name="txtHs" AutomationProperties.Name="Cao cửa sổ"/></StackPanel>
                  <CheckBox x:Name="chkNgang" Grid.Row="2" Grid.ColumnSpan="5" Margin="0,8,0,0" AutomationProperties.Name="Có thanh ngang trên cửa sổ"
                            Content="Có thanh ngang trên cửa sổ (bỏ chọn: cửa sổ lên sát khung trên)"/>
                  <StackPanel Grid.Row="3" Margin="0,8,0,0"><TextBlock Style="{DynamicResource Nhan}" Text="Sàn hoàn thiện"/><TextBox x:Name="txtSan" AutomationProperties.Name="Sàn hoàn thiện"/></StackPanel>
                  <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,8,0,0"><TextBlock Style="{DynamicResource Nhan}" Text="Bậu cửa sổ"/><TextBox x:Name="txtBau" AutomationProperties.Name="Bậu cửa sổ"/></StackPanel>
                  <TextBlock Grid.Row="4" Grid.ColumnSpan="5" Text="Cửa đi 2 cánh (Door-Curtain-Wall-Double-Glass)" FontSize="12" Foreground="{DynamicResource Di}" Margin="0,12,0,6"/>
                  <StackPanel Grid.Row="5"><TextBlock Style="{DynamicResource Nhan}" Text="Số lượng"/><TextBox x:Name="txtNd" AutomationProperties.Name="Số lượng cửa đi"/></StackPanel>
                  <StackPanel Grid.Row="5" Grid.Column="2"><TextBlock Style="{DynamicResource Nhan}" Text="Rộng tâm - tâm"/><TextBox x:Name="txtWd" AutomationProperties.Name="Rộng cửa đi"/></StackPanel>
                  <StackPanel Grid.Row="5" Grid.Column="4"><TextBlock Style="{DynamicResource Nhan}" Text="Cao cửa đi (từ sàn)"/><TextBox x:Name="txtHd" AutomationProperties.Name="Cao cửa đi"/></StackPanel>
                  <TextBlock x:Name="lblCao" Grid.Row="6" Grid.ColumnSpan="5" FontSize="11" Foreground="{DynamicResource Chu2}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </Grid>
              </Border>

              <Border Style="{DynamicResource Khung}" Margin="0,0,0,10">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock x:Name="lblDo" FontSize="17" FontWeight="Medium"/><TextBlock Text="Đố" FontSize="11" Foreground="{DynamicResource Chu2}"/></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock x:Name="lblKinh" FontSize="17" FontWeight="Medium"/><TextBlock Text="Ô kính" FontSize="11" Foreground="{DynamicResource Chu2}"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock x:Name="lblRong" FontSize="17" FontWeight="Medium"/><TextBlock Text="Rộng ô kính" FontSize="11" Foreground="{DynamicResource Chu2}"/></StackPanel>
                </Grid>
              </Border>

              <CheckBox x:Name="chkLat" Content="Lật cửa (mở sang phía bên kia)" AutomationProperties.Name="Lật cửa" Margin="2,0,0,2"/>
            </StackPanel>
          </ScrollViewer>

          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="10"/>
              <RowDefinition Height="230"/>
            </Grid.RowDefinitions>
            <Border Style="{DynamicResource Khung}" Padding="0">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="10,8,10,8">
                  <TextBlock Text="Bấm ô để đặt" FontSize="11" Foreground="{DynamicResource Chu2}" Margin="0,0,0,4"/>
                  <Border BorderBrush="{DynamicResource Ln}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                    <UniformGrid Rows="1">
                      <ToggleButton x:Name="tgSo" Style="{DynamicResource NutDoan}" AutomationProperties.Name="Đặt cửa sổ">
                        <StackPanel Orientation="Horizontal"><Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="{DynamicResource So}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Cửa sổ" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/></StackPanel>
                      </ToggleButton>
                      <ToggleButton x:Name="tgDi" Style="{DynamicResource NutDoan}" AutomationProperties.Name="Đặt cửa đi">
                        <StackPanel Orientation="Horizontal"><Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="{DynamicResource Di}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Cửa đi" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/></StackPanel>
                      </ToggleButton>
                    </UniformGrid>
                  </Border>
                </StackPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Ln}" BorderThickness="0,1,0,1" Padding="10,5">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="86"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Ô" FontSize="12" Foreground="{DynamicResource Chu2}"/>
                    <TextBlock Grid.Column="1" Text="Loại" FontSize="12" Foreground="{DynamicResource Chu2}"/>
                    <TextBlock Grid.Column="2" Text="Tâm - tâm" FontSize="12" Foreground="{DynamicResource Chu2}" HorizontalAlignment="Right"/>
                  </Grid>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel x:Name="spBang"/>
                </ScrollViewer>
              </DockPanel>
            </Border>
            <Border Grid.Row="2" Style="{DynamicResource Khung}" Padding="10,8">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Xem trước mặt đứng (nhìn từ phía đặt vách)" FontSize="11" Foreground="{DynamicResource Chu2}" Margin="0,0,0,4"/>
                <Canvas x:Name="cvMd" ClipToBounds="True" Background="Transparent"/>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>
      </Grid>

      <Border Grid.Row="2" Background="{DynamicResource Chan}" BorderBrush="{DynamicResource Ln}" BorderThickness="0,1,0,0" Padding="14,10">
        <DockPanel>
          <Button x:Name="btnOk" DockPanel.Dock="Right" Style="{DynamicResource NutChinh}" IsDefault="True" Margin="8,0,0,0" AutomationProperties.Name="Dựng vách">
            <StackPanel Orientation="Horizontal">
              <Path Style="{DynamicResource BieuTuong}" Data="M5 12.5l4.5 4.5L19 7.5" Stroke="White" Margin="0,0,6,0" Width="13" Height="13"/>
              <TextBlock Text="Dựng vách" Foreground="White"/>
            </StackPanel>
          </Button>
          <Button x:Name="btnHuy" DockPanel.Dock="Right" Content="Huỷ" IsCancel="True" AutomationProperties.Name="Huỷ"/>
          <TextBlock x:Name="lblTrangThai" FontSize="12" Foreground="{DynamicResource Chu2}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.AutomationId="trang_thai"/>
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
