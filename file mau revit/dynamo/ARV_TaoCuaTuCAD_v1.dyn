{
  "Uuid": "db964449-c50e-49cb-9ef9-72e4480f9bbd",
  "IsCustomNode": false,
  "Description": "Tạo cửa đi (family 1 cánh) gắn vào tường Revit có sẵn từ DWG đã link: nhận cửa theo cung mở cánh, bề rộng = khe lỗ tường CAD, hướng mở / bản lề theo cung. Dry-run mặc định.",
  "Name": "10. ARV_TaoCuaTuCAD_v1",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [
    {
      "Id": "92a19d30e9ca4fc9b466eeab5ea72b7d",
      "Name": "IN[0] Tên bản CAD (để trống = bản có layer cửa)",
      "Type": "string",
      "Type2": "string",
      "Value": "tầng 5-15",
      "Description": "Creates a string."
    },
    {
      "Id": "031d569da2fd46a09f5ff03d8df50a48",
      "Name": "IN[1] Lọc layer cửa đi (cách nhau bằng ;)",
      "Type": "string",
      "Type2": "string",
      "Value": "A-Door;A-Cửa",
      "Description": "Creates a string."
    },
    {
      "Id": "a3b192521ed447e6bb823ceda6e498a8",
      "Name": "IN[2] Lọc layer tường CAD để đo khe lỗ cửa",
      "Type": "string",
      "Type2": "string",
      "Value": "A-Wall",
      "Description": "Creates a string."
    },
    {
      "Id": "72c5e0c2cb4a4c42b3a088b1a686700e",
      "Name": "IN[3] Family cửa 1 cánh",
      "Type": "string",
      "Type2": "string",
      "Value": "CuaGoCongNghiep;LOGIA=CuaNhom_1Canh_MoQuay",
      "Description": "Creates a string."
    },
    {
      "Id": "7096f46a63ed47b4a17f35010aca195a",
      "Name": "IN[4] Level tường chủ",
      "Type": "string",
      "Type2": "string",
      "Value": "Tầng 5BA",
      "Description": "Creates a string."
    },
    {
      "Id": "684da26e076c489f9d71bc2f71a6d35b",
      "Name": "IN[5] Type mẫu để nhân bản",
      "Type": "string",
      "Type2": "string",
      "Value": "900x2200;LOGIA=900x2200",
      "Description": "Creates a string."
    },
    {
