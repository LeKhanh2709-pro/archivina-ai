      "NumberType": "Double",
      "Description": "Creates a number."
    },
    {
      "Id": "9d53d744b7414aa1b4cf8e67d0fd8d02",
      "Name": "IN[7] Chiều cao cửa (mm)",
      "Type": "number",
      "Type2": "number",
      "Value": "2200",
      "NumberType": "Double",
      "Description": "Creates a number."
    },
    {
      "Id": "339f6661d1db41c092cd3b9b4d97ee8b",
      "Name": "IN[8] Dry-run (True = chỉ báo cáo)",
      "Type": "boolean",
      "Type2": "boolean",
      "Value": "true",
      "Description": "Enables selection between True and False"
    }
  ],
