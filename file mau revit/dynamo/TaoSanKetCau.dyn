      "InputValue": false
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# TaoSanKetCau — tạo sàn kết cấu (Structural Floor) từ các đường bao vẽ sẵn\n# Revit 2026 / Dynamo 3.6 (CPython3)\n# IN[0] : các Model Line / Detail Line khép kín (có thể nhiều vòng);\n#         để trống -> lấy vùng chọn hiện tại trong Revit\n#         - vòng ngoài cùng  -> biên sàn\n#         - vòng nằm trong   -> lỗ mở (thang, thang máy, hộp KT)\n#         - nhiều vòng ngoài rời nhau -> nhiều tấm sàn\n# IN[1] : Level\n# IN[2] : Floor Type\n# IN[3] : Offset mặt sàn so với Level (mm), VD 0 hoặc -50\n# IN[4] : True = tạo sàn; False = chỉ kiểm tra, báo cáo\nimport clr\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nfrom Autodesk.Revit.DB import (CurveLoop, Floor, XYZ, Transform, UnitUtils,\n                               UnitTypeId, BuiltInParameter, CurveElement)\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\nfrom System.Collections.Generic import List\n\ndoc = DocumentManager.Instance.CurrentDBDocument\nTOL = UnitUtils.ConvertToInternalUnits(1.0, UnitTypeId.Millimeters)\n\n\ndef as_list(x):\n    if x is None:\n        return []\n    return list(x) if hasattr(x, '__iter__') and not isinstance(x, str) else [x]\n\n\nelems = [e for e in as_list(UnwrapElement(IN[0])) if e is not None]\nlevel = UnwrapElement(IN[1])\nftype = UnwrapElement(IN[2])\noffset_mm = float(IN[3] or 0)\nrun = bool(IN[4])\nmsgs = []\n\n# Node chọn trống -> lấy vùng chọn hiện tại trong Revit\nsrc = 'node Chọn đường bao'\nif not elems:\n    uidoc = DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\n    elems = [doc.GetElement(i) for i in uidoc.Selection.GetElementIds()]\n    src = 'vùng chọn trong Revit'\nmsgs.append('Nhận %d đối tượng từ %s' % (len(elems), src))\n\n# 1. Lấy curve, chiếu về cao độ level\ncurves = []\nfor e in elems:\n    if isinstance(e, CurveElement):\n        c = e.GeometryCurve\n        if not c.IsBound:  # vòng tròn kín -> tách 2 cung\n            p0 = 0.0\n            half = c.Period / 2.0\n            parts = []\n            for a, b in ((p0, p0 + half), (p0 + half, p0 + 2 * half)):\n                k = c.Clone()\n                k.MakeBound(a, b)\n                parts.append(k)\n        else:\n            parts = [c]\n        for k in parts:\n            dz = level.Elevation - k.GetEndPoint(0).Z\n            curves.append(k.CreateTransformed(Transform.CreateTranslation(XYZ(0, 0, dz))))\nskipped = len(elems) - len([e for e in elems if isinstance(e, CurveElement)])\nif skipped:\n    names = sorted(set(e.GetType().Name for e in elems if not isinstance(e, CurveElement)))\n    msgs.append('Bỏ qua %d đối tượng không phải Model/Detail Line (%s)' % (skipped, ', '.join(names)))\n\n\n# 2. Nối curve thành các vòng kín\ndef same(p, q):\n    return p.DistanceTo(q) < TOL\n\n\nloops, pool = [], curves[:]\nwhile pool:\n    chain = [pool.pop(0)]\n    start = chain[0].GetEndPoint(0)\n    end = chain[0].GetEndPoint(1)\n    while not same(start, end):\n        nxt = None\n        for i, c in enumerate(pool):\n            if same(c.GetEndPoint(0), end):\n                nxt = pool.pop(i)\n                break\n            if same(c.GetEndPoint(1), end):\n                nxt = pool.pop(i).CreateReversed()\n                break\n        if nxt is None:\n            break\n        chain.append(nxt)\n        end = nxt.GetEndPoint(1)\n    if same(start, end):\n        loops.append(chain)\n    else:\n        msgs.append('Vòng hở tại (%.0f, %.0f) mm — kiểm tra lại nét bao' %\n                    (end.X * 304.8, end.Y * 304.8))\n\n\n# 3. Đa giác 2D để tính diện tích / quan hệ trong–ngoài\ndef poly(chain):\n    pts = []\n    for c in chain:\n        pts.extend([(p.X, p.Y) for p in list(c.Tessellate())[:-1]])\n    return pts\n\n\ndef area(pts):\n    return abs(sum(pts[i][0] * pts[i - 1][1] - pts[i - 1][0] * pts[i][1]\n                   for i in range(len(pts)))) / 2.0\n\n\ndef inside(pt, pts):\n    x, y, res = pt[0], pt[1], False\n    for i in range(len(pts)):\n        x1, y1 = pts[i - 1]\n        x2, y2 = pts[i]\n        if (y1 > y) != (y2 > y) and x < (x2 - x1) * (y - y1) / (y2 - y1) + x1:\n            res = not res\n    return res\n\n\npolys = [poly(l) for l in loops]\ndepth = [sum(1 for j in range(len(loops)) if j != i and inside(polys[i][0], polys[j]))\n         for i in range(len(loops))]\n\n# 4. Gom: vòng chẵn = biên sàn, vòng lẻ nằm ngay trong = lỗ mở\nslabs = []\nfor i in range(len(loops)):\n    if depth[i] % 2:\n        continue\n    holes = [j for j in range(len(loops)) if depth[j] == depth[i] + 1\n             and inside(polys[j][0], polys[i])]\n    slabs.append((i, holes))\n\nft = UnitUtils.ConvertToInternalUnits(1.0, UnitTypeId.Millimeters)\nreport = []\nfor i, holes in slabs:\n    a = (area(polys[i]) - sum(area(polys[j]) for j in holes)) * 0.09290304\n    report.append('Sàn %d: %.2f m², %d lỗ mở' % (len(report) + 1, a, len(holes)))\n\nfloors = []\nif run and slabs:\n    TransactionManager.Instance.EnsureInTransaction(doc)\n    for i, holes in slabs:\n        cls = List[CurveLoop]()\n        outer = CurveLoop()\n        for c in loops[i]:\n            outer.Append(c)\n        if not outer.IsCounterclockwise(XYZ.BasisZ):\n            outer.Flip()\n        cls.Add(outer)\n        for j in holes:\n            h = CurveLoop()\n            for c in loops[j]:\n                h.Append(c)\n            if h.IsCounterclockwise(XYZ.BasisZ):\n                h.Flip()\n            cls.Add(h)\n        fl = Floor.Create(doc, cls, ftype.Id, level.Id, True, None, 0.0)\n        fl.get_Parameter(BuiltInParameter.FLOOR_HEIGHTABOVELEVEL_PARAM).Set(offset_mm * ft)\n        floors.append(fl)\n    TransactionManager.Instance.TransactionTaskDone()\n    msgs.append('ĐÃ TẠO %d sàn kết cấu \"%s\" tại %s, offset %.0f mm'\n                % (len(floors), ftype.get_Parameter(BuiltInParameter.SYMBOL_NAME_PARAM).AsString(),\n                   level.Name, offset_mm))\nelif slabs:\n    msgs.append('Chế độ KIỂM TRA — đổi nút Chạy = True rồi bấm Run để tạo sàn')\nelse:\n    msgs.append('Không tìm thấy vòng bao kín nào — vẽ Model/Detail Line khép kín, '\n                'chọn chúng (node 1: Select → quét → Finish, hoặc chọn sẵn trong Revit) rồi Run')\n\nOUT = report + msgs, floors\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "fd947b44042b42a5a1563f616ea81f00",
