      "NumberType": "Double"
    },
    {
      "Id": "b0f1805c0eb5400e9b39ee1e9e2c92ae",
      "Name": "IN[4] Nhận WC theo Comments / tên type sàn / tên phòng (cách ;)",
      "Description": "Creates a string.",
      "Type": "string",
