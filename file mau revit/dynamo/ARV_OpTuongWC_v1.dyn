    "Annotations": [
      {
        "Id": "bbe5e52a667c43b2a43b914040240623",
        "Title": "1. Đầu vào",
        "DescriptionText": "Chọn sàn hoàn thiện WC (hoặc Room WC) trong Revit, hoặc không chọn gì và mở view mặt bằng của tầng để làm mọi WC trên tầng. Chọn kích thước gạch ở IN[0] + hướng ở IN[1]. IN[9]: mạch ốp trùng mạch lát sàn. IN[10]: WC đã có ốp → xoá ốp cũ của tool rồi dựng lại. Giữ Dry-run = True cho lần chạy đầu, đọc Báo cáo rồi mới đổi False.",
        "IsExpanded": true,
        "WidthAdjustment": 0.0,
        "HeightAdjustment": 0.0,
        "Nodes": [
          "d6ea53b4fcc84737ae3af779959d762a",
          "5f986f5049fe4c8e89acd5dfc52beee8",
          "4c7405d5f9874ca195b22403d7cafc75",
          "2197f14b93b74d7c849eaa37cccbbf29",
