      "Name": "IN[1] Hướng lát: NGANG (cạnh dài nằm ngang) / DOC",
      "Description": "Creates a string.",
      "Type": "string",
      "Type2": "string",
      "Value": "NGANG"
    },
    {
      "Id": "4c7405d5f9874ca195b22403d7cafc75",
      "Name": "IN[2] Chiều cao ốp (mm)",
