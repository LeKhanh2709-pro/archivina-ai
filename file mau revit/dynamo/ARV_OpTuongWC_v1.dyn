      "Name": "IN[5] Id sàn / phòng WC (trống = đang chọn; không chọn = cả level của view)",
      "Description": "Creates a string.",
      "Type": "string",
      "Type2": "string",
      "Value": ""
    },
    {
      "Id": "81aa176c28794a9f87494ecbcbf2b9bb",
      "Name": "IN[6] Wall type ốp mẫu để nhân bản",
      "Description": "Creates a string.",
      "Type": "string",
