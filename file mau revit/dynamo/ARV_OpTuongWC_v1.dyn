      "Value": "GO-Gạch ốp-300x600"
    },
    {
      "Id": "d270fd72d10c4dc09aebbb296569551d",
      "Name": "IN[7] Nối khối với tường chủ (cửa cắt lớp ốp)",
      "Description": "Enables selection between True and False",
      "Type": "boolean",
      "Type2": "boolean",
      "Value": "true"
    },
