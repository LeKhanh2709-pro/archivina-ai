        },
        {
          "Id": "9de2806b963d4717978e5c4dbca2e62a",
          "Name": "IN[8]",
          "Description": "IN[8] Layer thiết bị WC trong CAD",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "3333f75ffdad4479b83f46aff9e9034d",
          "Name": "IN[9]",
          "Description": "IN[9] Floor type theo loại",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "2e8a5a604e7c4fac811ad0f81f8b8a39",
          "Name": "IN[10]",
          "Description": "IN[10] Cao độ mặt sàn so với Level (mm)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
