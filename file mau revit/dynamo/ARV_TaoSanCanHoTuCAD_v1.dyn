{
  "Uuid": "070744a1-beb1-4472-a147-fe7b552f353f",
  "IsCustomNode": false,
  "Description": "Tạo sàn hoàn thiện kiến trúc cho phòng ngủ, khách, WC, logia của các căn hộ trên level của view đang mở, lấy polyline căn + tên căn + cột + thiết bị WC từ CAD link, biên theo mặt tường Revit. Dry-run mặc định.",
  "Name": "ARV_TaoSanCanHoTuCAD_v1",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [
    {
      "Id": "1bf5ae5975e441b499566d24dd3f4d77",
      "Name": "IN[0] Tên bản CAD (trống = bản CAD duy nhất)",
      "Type": "string",
      "Type2": "string",
      "Value": "G19",
      "Description": "Creates a string."
    },
    {
      "Id": "5aaa3eab249a46db9a9cf6dd2bac51e8",
      "Name": "IN[1] Layer polyline căn hộ",
      "Type": "string",
      "Type2": "string",
      "Value": "00 do dt",
      "Description": "Creates a string."
    },
    {
      "Id": "877bdfb030414f998fe77e431dd636f4",
      "Name": "IN[2] Layer chữ tên căn",
      "Type": "string",
      "Type2": "string",
      "Value": "A-Text",
      "Description": "Creates a string."
    },
    {
      "Id": "d97f4deb56314048b0df5dc0effb2306",
      "Name": "IN[3] Mẫu tên căn (regex)",
      "Type": "string",
      "Type2": "string",
      "Value": "^CH\\d+",
      "Description": "Creates a string."
    },
    {
      "Id": "ff27b164cb0d4fc3a95248c6dd032b2a",
      "Name": "IN[4] Layer cột CAD khoét khỏi sàn (trống = không)",
      "Type": "string",
      "Type2": "string",
      "Value": "A-Column",
      "Description": "Creates a string."
    },
    {
      "Id": "e1343f39577149cc8a2f6564eb9b49d6",
      "Name": "IN[5] Sàn cách mặt cột CAD (mm)",
      "Type": "number",
      "Type2": "number",
      "Value": "15",
      "NumberType": "Double",
      "Description": "Creates a number."
    },
    {
      "Id": "6009b9e8fddc4574a563570bfd9ed3a7",
      "Name": "IN[6] Cửa ra logia: tên family/type chứa",
      "Type": "string",
      "Type2": "string",
      "Value": "trượt",
      "Description": "Creates a string."
    },
    {
      "Id": "172fd29b9a7f4cde9461a7e10caa11d7",
      "Name": "IN[7] Điểm dò logia cách tâm cửa về phía Facing (mm)",
      "Type": "number",
      "Type2": "number",
      "Value": "400",
      "NumberType": "Double",
      "Description": "Creates a number."
    },
    {
      "Id": "41e811f1b58c48008217d69c949cb190",
      "Name": "IN[8] Layer thiết bị WC trong CAD",
      "Type": "string",
      "Type2": "string",
      "Value": "A-Interior WC",
      "Description": "Creates a string."
    },
    {
      "Id": "8fa8c827f1ab42888cca912d578a5728",
      "Name": "IN[9] Floor type theo loại",
      "Type": "string",
      "Type2": "string",
      "Value": "KHO=SHT-Gỗ Công Nghiệp;WC=SHT-Gach Lat WC-300x600;LOGIA=SHT-Gach Lat Logia-300x600;CHANCUA=FF-Đá Granite tự nhiên",
      "Description": "Creates a string."
    },
    {
      "Id": "341c410777af477b96e2df9bf04dd467",
      "Name": "IN[10] Cao độ mặt sàn so với Level (mm)",
      "Type": "string",
      "Type2": "string",
      "Value": "KHO=0;WC=-15;LOGIA=-30;CHANCUA=0",
      "Description": "Creates a string."
    },
    {
      "Id": "981d7b4dd2fe4235ba673c83cf022b2e",
      "Name": "IN[11] WC lùi biên thêm (mm)",
      "Type": "number",
      "Type2": "number",
      "Value": "10",
      "NumberType": "Double",
      "Description": "Creates a number."
    },
    {
      "Id": "d97b26b6215d4c5393fc1ad3f8f126a7",
      "Name": "IN[12] Chỉ làm các căn (trống = tất cả)",
      "Type": "string",
      "Type2": "string",
      "Value": "",
      "Description": "Creates a string."
    },
    {
      "Id": "617b6b4e4cac42678bed9ba5081aaace",
      "Name": "IN[13] DRY-RUN: True = chỉ báo cáo / False = GHI VÀO MÔ HÌNH",
      "Type": "boolean",
      "Type2": "boolean",
      "Value": "false",
      "Description": "Enables selection between True and False"
    },
    {
      "Id": "3029acda4058487683f119be02121dd5",
      "Name": "IN[14] Floor type kiến trúc mẫu để nhân bản type thiếu",
      "Type": "string",
      "Type2": "string",
      "Value": "SHT-Gach Lat-600x600",
      "Description": "Creates a string."
    },
    {
      "Id": "490f8528af3d46d9a7b5bc59a233fa48",
      "Name": "IN[15] Line style đường bo phòng (trống = không vẽ)",
      "Type": "string",
      "Type2": "string",
      "Value": "AV.Nét Hatch Lát Sàn",
      "Description": "Creates a string."
    },
    {
      "Id": "eabb8e3b6d4643c185ecb6669ec89f4a",
      "Name": "IN[16] Tạo lại: xoá sàn + đường bo cũ của tool trong các căn",
      "Type": "boolean",
      "Type2": "boolean",
      "Value": "false",
      "Description": "Enables selection between True and False"
    }
  ],
