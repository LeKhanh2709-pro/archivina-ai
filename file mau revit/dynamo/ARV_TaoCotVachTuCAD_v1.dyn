          "KeepListStructure": false
        },
        {
          "Id": "e019c388acc743ee9d59486c70e63ec0",
          "Name": "IN[6]",
          "Description": "IN[6] Tên wall type mẫu",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
