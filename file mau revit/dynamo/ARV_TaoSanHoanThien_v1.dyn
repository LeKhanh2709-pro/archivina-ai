{
  "Uuid": "d161e0d9-4fa6-4710-9e82-ab61ec824b7d",
  "IsCustomNode": false,
  "Description": "Tạo sàn hoàn thiện cho căn hộ đã chọn từ DWG mặt bằng lát sàn đã link: bo phòng = biên sàn, loại phòng theo hatch (khô 0 / WC −15 / logia −30), đá chân cửa theo hatch AR-CONC, ô cửa đo trên tường Revit. Dry-run mặc định.",
  "Name": "ARV_TaoSanHoanThien_v1",
  "ElementResolver": {
    "ResolutionMap": {}
  },
