    "Annotations": [
      {
        "Id": "492625c90da445a7bcbc2885410fca33",
        "Title": "1. Đầu vào",
        "DescriptionText": "Mở view mặt bằng tầng cần làm, CHỌN CỬA VÀO CĂN trong Revit (chọn nhiều căn được) rồi Run. IN[6]: điền floor type cho KHO / WC / LOGIA (type có sẵn, tool không tạo type). Giữ Dry-run = True cho lần chạy đầu. IN[10]: floor type ở IN[6] chưa có → tự nhân bản từ type kiến trúc mẫu này khi chạy thật.",
        "IsExpanded": true,
        "WidthAdjustment": 0.0,
        "HeightAdjustment": 0.0,
        "Nodes": [
          "120588eb9cdc4ea09ce657d50f19db70",
