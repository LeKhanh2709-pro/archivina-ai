    },
    {
      "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels",
      "SerializedWidth": 0.0,
      "SerializedHeight": 0.0,
      "Id": "e0aa47bc06a548098f88513720e30a0b",
      "NodeType": "StringInputNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "d6b705df60d14207922fc0b6dcb2c577",
          "Name": "",
          "Description": "",
