{
  "Uuid": "834d9509-2846-4d49-8635-3c70ab033793",
  "IsCustomNode": false,
  "Description": "Tạo cửa sổ nhỏ (≤ 1500 mm) cho phòng ngủ và WC, gắn vào tường Revit có sẵn từ DWG đã link: ô cửa sổ theo nét layer A-Window trong bề dày tường, loại phòng theo Room hai bên, tự nhân bản type theo bề rộng. Dry-run mặc định.",
  "Name": "13. ARV_TaoCuaSoTuCAD_v1",
  "ElementResolver": {
    "ResolutionMap": {}
  },
