{
  "Uuid": "10b0776f-4645-4635-bcd5-aa8698e38eec",
  "IsCustomNode": false,
  "Description": "Dàn trang hồ sơ chi tiết căn hộ theo mẫu CAD CT1-CH02-CTCH: Room, view MB nội thất / tường xây / lát sàn / trần, chi tiết WC + logia, tag, sheet A1. Dry-run mặc định.",
  "Name": "ARV_DanTrangCanHo_v1",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [
    {
