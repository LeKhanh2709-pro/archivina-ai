{
  "Uuid": "5e7708ab-3168-443d-93f1-33842f12ff35",
  "IsCustomNode": false,
  "Description": "Đặt nội thất khu bếp trong phòng khách ăn từ DWG đã link, nhận diện theo hình: tủ lạnh, tủ bếp thẳng / chữ L, bếp từ, chậu rửa (Furniture 2D) và đá mặt tủ (Floor) theo biên tủ. Áp mặt hoàn thiện, đặt cỡ theo CAD, nội thất trên mặt sàn 21 mm. Dry-run mặc định.",
  "Name": "26. ARV_TaoNoiThatBepTuCAD_v1",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [
    {
      "Id": "38afa77fb9d849c68dd7138f352fa452",
