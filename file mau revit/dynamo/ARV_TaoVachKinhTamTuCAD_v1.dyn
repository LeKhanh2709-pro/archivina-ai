{
  "Uuid": "bac1678a-44e8-4f96-b99a-d6d365e6d769",
  "IsCustomNode": false,
  "Description": "Tạo vách kính tắm (Plumbing Fixtures) trong WC từ DWG đã link, nhận diện theo cung mở cánh + tấm kính (buồng thẳng, buồng vát góc), nhân bản type chọn ở IN[3] / IN[4] cho khớp chiều dài CAD, đầu vách theo mặt hoàn thiện. Dry-run mặc định. TRẠNG THÁI: CHƯA DUYỆT.",
  "Name": "17. ARV_TaoVachKinhTamTuCAD_v1",
