{
  "Uuid": "cc8d5c84-95fc-4cb8-81a2-31eb5b990ebc",
  "IsCustomNode": false,
  "Description": "Tạo tường kiến trúc từ mặt bằng tường DWG đã link (cặp nét song song → tim tường, wall type theo chiều dày CAD). Mặc định dry-run. TRẠNG THÁI: CHƯA DUYỆT.",
  "Name": "ARV_TaoTuongTuCAD_v1",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [
