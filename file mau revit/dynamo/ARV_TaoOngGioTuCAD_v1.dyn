      "Name": "IN[1] Layer ống gió (cách ;)",
      "Type": "string",
      "Type2": "string",
      "Value": "AV-M-TG-CAP KHI BU;AV-M-TG-HUT KHOI;AV-M-TG-TANG AP",
      "Description": "Creates a string."
    },
    {
      "Id": "a08528dd6cb748408ddbee737bec3062",
      "Name": "IN[2] System theo tên layer",
      "Type": "string",
      "Type2": "string",
      "Value": "CAP KHI BU=AV_M_Gió Tươi;HUT KHOI=AV_M_Hút khói;TANG AP=AV_M_Tăng áp",
      "Description": "Creates a string."
    },
    {
      "Id": "3a2d98107cec440c8d6f8281b0234609",
