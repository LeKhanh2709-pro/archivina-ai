{
  "Uuid": "9a32c75b-9a25-4da4-9fd5-44a28f9b8c30",
  "IsCustomNode": false,
  "Description": "Tạo ống gió chữ nhật (Duct) từ DWG thông gió đã Link: tim ống từ cặp nét thành ống, W×H và cao độ đáy theo chữ 'WxH ... BOD: FL+x.xxx'. Tự nối cút / côn / bích / tê / chân rẽ theo Routing Preferences, chuyển cao độ bằng đoạn dốc + 2 cút. Dry-run mặc định.",
  "Name": "ARV_TaoOngGioTuCAD_v1",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [
