      "Type2": "string",
      "Value": "AV-M-AC-text 1",
      "Description": "Creates a string."
    },
    {
      "Id": "786477fec2ec46ecaacc02f2b92f934e",
      "Name": "IN[4] Level gốc FL (trống = level view)",
