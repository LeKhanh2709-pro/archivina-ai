          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "c7864828eaa344b5a90c5ec63b481711",
          "Name": "IN[5]",
          "Description": "IN[5] Lưng tủ CAD cách mặt tường tối đa (mm)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "8ec4fc7d69b0432d9d437aa4620f5493",
